{
    "name": "dts/document-tracking-system",
    "type": "project",
    "description": "Document Tracking System for Philippine Government Agencies",
    "keywords": ["laravel", "document-tracking", "government"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^2.0",
        "http-interop/http-factory-guzzle": "^1.2",
        "intervention/image": "^3.0",
        "laravel/framework": "^11.0",
        "laravel/reverb": "*",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.3",
        "laravel/tinker": "^2.9",
        "meilisearch/meilisearch-php": "^1.16",
        "predis/predis": "^3.5",
        "simplesoftwareio/simple-qrcode": "^4.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-permission": "^6.0",
        "zbateson/mail-mime-parser": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "laravel/telescope": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"cyan,magenta\" -n \"backend,frontend\" \"php artisan serve\" \"npm --prefix ../frontend run dev\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-m5cs-t1y6-qpcs",
                    "PKSA-3r5d-mb8f-1qw9",
                    "PKSA-mdq4-51ck-6kdq",
                    "PKSA-8qx3-n5y5-vvnd",
                    "PKSA-q46n-4fdk-zjr4",
                    "PKSA-qzrn-rnz3-85w1",
                    "PKSA-w7xr-vk7n-rstm",
                    "PKSA-p3rx-dfwp-73ny",
                    "PKSA-ckwp-rt7t-c46m",
                    "PKSA-njrm-6dtg-m2pc",
                    "PKSA-cv56-2228-pzr6",
                    "PKSA-6r8f-nxsb-67bq",
                    "PKSA-gh7h-hhy4-byg7",
                    "PKSA-mwt3-h9tv-kx78",
                    "PKSA-hp6n-n4kz-21wk",
                    "PKSA-mckv-s5hg-868k",
                    "PKSA-7ztm-rpt3-qqzk",
                    "PKSA-2kw5-jd8w-5mvh",
                    "PKSA-4jrs-y99s-q8j6",
                    "PKSA-hbk6-2vfz-8f8n"
                ]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
