APP_NAME="DTS - Document Tracking System"
APP_ENV=production
APP_KEY=

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (Docker Compose service names) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dts_database
DB_USERNAME=dts_user
DB_PASSWORD=change_me_db_password

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# --- Broadcast ---
BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# --- Cache ---
CACHE_DRIVER=redis
CACHE_PREFIX=dts_cache

# --- Redis ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Reverb ---
REVERB_APP_ID=dts-app
REVERB_APP_KEY=dts-reverb-key
REVERB_APP_SECRET=dts-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dts.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# --- Meilisearch / Scout ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=dts_meili_key_2024

# --- Semaphore SMS API (Philippines) ---
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=DTS

# --- QR Code ---
QRCODE_SIZE=300
