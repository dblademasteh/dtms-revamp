APP_NAME="DTMS - Document Tracking and Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=dts-postgres
DB_PORT=5432
DB_DATABASE=dts_database
DB_USERNAME=dts_user
DB_PASSWORD=your_secure_db_password_here

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_DRIVER=redis
CACHE_PREFIX=dts_cache

REDIS_CLIENT=predis
REDIS_HOST=dts-redis
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@dts.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=your-domain.com

SCOUT_DRIVER=database
MEILISEARCH_HOST=http://dts-meilisearch:7700
MEILISEARCH_KEY=dts_master_key_2024

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=DTMS

QRCODE_SIZE=300