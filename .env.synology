# ============================================================
# DTS - Synology Deployment Environment Configuration
# ============================================================
# Copy this file to ".env" in the same directory as
# docker-compose.synology.yml before deploying.
#
# APP_KEY is auto-generated by the backend on first run
# and persisted in the bind-mounted backend/.env file.
# ============================================================

# --- Paths & Ports ---
# Base directory on the Synology NAS for all persistent data.
# Default assumes /volume1/docker/dts (create this shared folder first).
DOCKER_BASE_PATH=/volume1/docker/dts

# External ports exposed on the Synology NAS.
FRONTEND_PORT=80
BACKEND_PORT=8000

# --- Application ---
APP_NAME=DTS - Document Tracking System
APP_ENV=production
APP_URL=http://YOUR_SYNOLOGY_IP_OR_DOMAIN

# Generate with: echo "base64:$(openssl rand -base64 32)"
# NOTE: APP_KEY is auto-generated by the backend entrypoint on first run
# and persisted in the bind-mounted backend/.env file. You can optionally
# pre-set it here for full control, but it is not required.
# APP_KEY=

# --- Session / Sanctum ---
# Set to your Synology's IP or domain (no port) so session cookies
# work correctly when accessed from a browser.
SESSION_DOMAIN=YOUR_SYNOLOGY_IP_OR_DOMAIN
SANCTUM_STATEFUL_DOMAINS=YOUR_SYNOLOGY_IP_OR_DOMAIN

# --- Database ---
DB_DATABASE=dts_database
DB_USERNAME=dts_user
DB_PASSWORD=change_me_db_password

# --- Redis ---
# Redis runs without a password in this self-contained stack.
# (Leave REDIS_PASSWORD empty.)

# --- Meilisearch ---
MEILISEARCH_KEY=change_me_meili_key

# --- Reverb (WebSockets) ---
# These should match APP_URL so the browser connects to the right host.
# Leave VITE_REVERB_HOST/PORT empty to use the browser's own origin
# (recommended for same-origin deployments).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=dts-app
REVERB_APP_KEY=dts-reverb-key
REVERB_APP_SECRET=dts-reverb-secret
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=dts-reverb-key

# --- Mail ---
# Options: log (default, no emails sent), smtp, or mailgun/smtp for real mail.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@dts.gov.ph

# --- SMS (Philippines) ---
SEMAPHORE_SENDER_NAME=DTS
# SEMAPHORE_API_KEY=
