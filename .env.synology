# ============================================================
# DTS - Synology Deployment Environment Configuration
# ============================================================
# Copy this file to ".env" in the same directory as
# docker-compose.synology.yml before deploying.
#
# APP_KEY is auto-generated by the backend on first run and
# persisted in ${DOCKER_BASE_PATH}/backend/.env (bind-mounted).
# Create that file first (it may be empty):
#   mkdir -p ${DOCKER_BASE_PATH}/backend
#   touch ${DOCKER_BASE_PATH}/backend/.env
# ============================================================

# --- Paths & Ports ---
# Base directory on the Synology NAS for all persistent DATA (DB, Redis, Meili,
# uploads). Keep it OUTSIDE the git checkout (e.g. code = /volume1/docker/dts-project,
# data = /volume1/docker/dts). Create this shared folder first.
DOCKER_BASE_PATH=/volume1/docker/dts

# External ports exposed on the Synology NAS.
FRONTEND_PORT=80
BACKEND_PORT=8000

# --- Application ---
APP_NAME=DTMS - Document Tracking and Management System
APP_ENV=production
APP_URL=https://dtms.devbry.online
FRONTEND_URL=https://dtms.devbry.online

# Set to true when serving over HTTPS (Cloudflare tunnel / reverse proxy).
SESSION_SECURE_COOKIE=true

# --- Cloudflare Tunnel (required for public HTTPS access) ---
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
# In the tunnel's Public Hostname, route your domain to http://localhost:80
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_YOUR_TUNNEL_TOKEN

# --- Session / Sanctum ---
# Set to your public domain (e.g. dtms.devbry.online). Leave SESSION_DOMAIN
# empty for a host-only cookie when unsure.
SESSION_DOMAIN=dtms.devbry.online
SANCTUM_STATEFUL_DOMAINS=dtms.devbry.online

# --- Database ---
DB_DATABASE=dts_database
DB_USERNAME=dts_user
DB_PASSWORD=change_me_db_password

# --- Backups ---
# Number of nightly backups to keep (runs at 03:00 Asia/Manila)
DB_BACKUP_RETENTION=14

# --- Redis ---
# Redis runs without a password in this self-contained stack.
# (Leave REDIS_PASSWORD empty.)

# --- Meilisearch ---
MEILISEARCH_KEY=change_me_meili_key

# --- Reverb (WebSockets) ---
# These should match APP_URL so the browser connects to the right host.
# Leave VITE_REVERB_HOST/PORT empty to use the browser's own origin
# (recommended for same-origin deployments).
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=dts-app
REVERB_APP_KEY=dts-reverb-key
REVERB_APP_SECRET=dts-reverb-secret
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=dts-reverb-key

# --- Mail (Gmail SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_GMAIL_ADDRESS
MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=REPLACE_WITH_GMAIL_ADDRESS
MAIL_FROM_NAME=DTMS

# --- SMS (Philippines) ---
SEMAPHORE_SENDER_NAME=DTMS
# SEMAPHORE_API_KEY=
